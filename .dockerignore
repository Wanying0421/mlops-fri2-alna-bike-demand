# Start with an empty context, then allow only the required project inputs.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!.python-version
!README.md
!src/
!src/**
!configs/
!configs/baseline.yaml
!data/
!data/README.md
!data/UCI-original-Readme.txt
!data/manifest.json
!data/raw/
!data/raw/hour.csv
!tests/
!tests/**
!.github/
!.github/workflows/
!.github/workflows/ci.yml
!reports/
!reports/week-01-team.md

# Exclude local state and secrets even inside allowed directories.
**/.venv
**/.git
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.env
**/.env.*
**/secrets
